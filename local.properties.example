## Copy to local.properties and add your keys (local.properties is gitignored).
sdk.dir=/path/to/Android/sdk

# AI provider: "gemini" (default) or "openai"
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Google Drive (C1): create Android OAuth client in Google Cloud Console.
# No keys in local.properties required — use package name + SHA-1 in console.
